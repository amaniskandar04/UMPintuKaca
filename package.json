{
  "name": "um-reviews",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @um-reviews/shared",
    "build:shared": "npm run build -w @um-reviews/shared",
    "predev:api": "node scripts/gen-dev-vars.mjs",
    "dev:api": "npm run build:shared && npm run dev -w @um-reviews/api",
    "dev:web": "npm run build:shared && npm run dev -w @um-reviews/web",
    "typecheck": "npm run build:shared && npm run typecheck -w @um-reviews/api && npm run typecheck -w @um-reviews/web",
    "build": "npm run build:shared && npm run build -w @um-reviews/web",
    "db:migrate": "npm run db:migrate:local -w @um-reviews/api",
    "mine:clubs": "node scripts/mine-clubs.mjs",
    "mine:campus": "node scripts/mine-campus.mjs",
    "mine:programs": "node scripts/mine-programs.mjs",
    "mine:courses:s2": "node scripts/mine-courses.mjs --semester=2025/S2 --label=s2_2025_2026",
    "fetch:catalog": "node scripts/fetch-timeedit-catalog.mjs",
    "extract:subjects": "node scripts/extract-timeedit-subjects.mjs",
    "refresh:subjects": "npm run fetch:catalog && npm run extract:subjects",
    "sdk:login": "node scripts/sdk-browser-scrape.mjs --cookie-only",
    "sdk:probe": "node scripts/sdk-browser-scrape.mjs --probe-only --use-saved-cookie",
    "sdk:scrape": "node scripts/sdk-browser-scrape.mjs --scrape-only --use-saved-cookie",
    "sdk:refresh": "node scripts/sdk-browser-scrape.mjs --use-saved-cookie",
    "db:seed": "npm run db:seed:local -w @um-reviews/api",
    "db:seed:courses:s2": "npm run db:seed:courses:s2:local -w @um-reviews/api",
    "db:seed:programs": "npm run db:seed:programs:local -w @um-reviews/api",
    "db:seed:clubs": "npm run db:seed:clubs:local -w @um-reviews/api",
    "db:seed:places": "npm run db:seed:places:local -w @um-reviews/api",
    "db:seed:demo": "npm run db:seed:demo:local -w @um-reviews/api",
    "webhook:set": "node scripts/set-webhook.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "An anonymous course and programme review app for Universiti Malaya students, delivered as a Telegram Mini App with a Telegram bot.",
  "main": "index.js",
